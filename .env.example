# FROST Server
FROST_SERVER=https://frost-dev.urbreath.tech/FROST-Server/v1.1
FROST_TIMEOUT=15

# MinIO (S3-compatible) — leave blank to disable uploads
MINIO_ENDPOINT=minio-api-dev.urbreath.tech
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=sensordata
MINIO_PATH_PREFIX=cluj-napoca/air-quality/

# Source API
SOURCE_API_URL=https://data.e-primariaclujnapoca.ro/calitate_aer/

# Polling settings
POLLING_INTERVAL=300
POLLING_WORKERS=8

# Paths (inside the container — usually no need to change)
STATE_FILE=/app/state/last_processed.json
HEARTBEAT_FILE=/app/state/heartbeat
MAPPING_FILE=/app/sensor_mapping.json
